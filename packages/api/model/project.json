{
  "name": "@aws-samples/smart-product-onboarding-api-model",
  "root": "packages/api/model",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/api/model/bundle-spec.mjs"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/bundle-spec.mjs"],
      "outputs": ["{projectRoot}/.api.json"]
    },
    "compile": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"]
    }
  }
}
