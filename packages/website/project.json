{
  "name": "@aws-samples/smart-product-onboarding-demo-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/website/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["lint", "compile", "bundle", "test"]
    },
    "pre-compile": {
      "executor": "nx:run-commands",
      "dependsOn": ["@aws-samples/smart-product-onboarding-api-model:generate"],
      "options": {
        "commands": [
          "rm -rf public/smart-product-onboarding-api",
          "mkdir -p public/smart-product-onboarding-api && cp ../api/model/.api.json public/smart-product-onboarding-api/api.json"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "inputs": ["{projectRoot}/../api/model/.api.json"],
      "outputs": ["{projectRoot}/public/smart-product-onboarding-api"]
    },
    "compile": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "pre-compile",
        "@aws-samples/smart-product-onboarding-api-typescript-react-query-hooks:build"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc --build tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "pre-compile",
        "@aws-samples/smart-product-onboarding-api-typescript-react-query-hooks:build"
      ],
      "outputs": ["{workspaceRoot}/dist/packages/website/bundle"],
      "defaultConfiguration": "production",
      "options": {
        "command": "vite build --mode production",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint 'src/**/*.{ts,tsx,js,jsx}'",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint 'src/**/*.{ts,tsx,js,jsx}' --fix",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "dependsOn": ["bundle"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "pre-compile",
        "@aws-samples/smart-product-onboarding-api-typescript-react-query-hooks:build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "command": "vite --mode development",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development"
        },
        "production": {
          "command": "vite --mode production"
        }
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "command": "vite preview --outDir ../../dist/packages/website/bundle",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/website"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    }
  }
}
