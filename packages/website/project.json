{
  "name": "@aws-samples/smart-product-onboarding-demo-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/website/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "bundle",
        "test"
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc --build tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/packages/website/bundle"
      ],
      "defaultConfiguration": "production",
      "options": {
        "command": "vite build --mode production",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint 'src/**/*.{ts,tsx,js,jsx}'",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint 'src/**/*.{ts,tsx,js,jsx}' --fix",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "dependsOn": [
        "bundle"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "vite --mode development",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development"
        },
        "production": {
          "command": "vite --mode production"
        }
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "bundle"
      ],
      "options": {
        "command": "vite preview --outDir ../../dist/packages/website/bundle",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/packages/website"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "generate-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "openapi-typescript ../api/model/src/main/openapi/main.yaml --output src/api/schema.d.ts --default-non-nullable=false",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/packages/api/model/src/**/*",
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/src/api/schema.d.ts"
      ]
    }
  }
}
